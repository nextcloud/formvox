{
  "name": "voxcloud/formvox",
  "description": "File-based forms and polls for Nextcloud",
  "type": "nextcloud-app",
  "license": "AGPL-3.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "doctrine/dbal": "^4.0",
    "nextcloud/coding-standard": "^1.3",
    "nextcloud/ocp": "dev-stable32",
    "phpunit/phpunit": "^10.5",
    "vimeo/psalm": "^5.26"
  },
  "autoload": {
    "psr-4": {
      "OCA\\FormVox\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OCA\\FormVox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:integration": "phpunit --configuration phpunit.integration.xml",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './node_modules/*' -print0 | xargs -0 -n1 php -l",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "psalm": "psalm --no-cache",
    "psalm:baseline": "psalm --no-cache --set-baseline=tests/psalm-baseline.xml"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "php-cs-fixer/shim": true
    }
  }
}

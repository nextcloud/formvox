# Dependencies
node_modules/

# Build artifacts (keep js/ for deployment)
# js/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
*.env
.env.local

# Temporary files
*.tmp
*.temp

# Release artifacts (uploaded to GitHub releases, not in git)
formvox-*.tar.gz

# Certificates and private keys (NEVER commit to GitHub!)
*.key
*.pem
certificates/*.key
certificates/*.csr
certificates/*.crt
certificates/

# l10n build artefacts. en.json/en.js are generated from the source by
# scripts/extract-en-json.js — the POT template is the translation source of
# truth, and the Nextcloud sync-bot removes en.json from the repo after a sync.
# NOTE: l10n/.source-count.json and l10n/.source-strings.json ARE committed on
# purpose — scripts/check-l10n-sync.js compares against them to catch source
# strings that were changed without regenerating the POT.
l10n/en.json
l10n/en.js

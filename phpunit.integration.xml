<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap-integration.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true">
    <!--
      failOnWarning is deliberately NOT set here (unlike the unit phpunit.xml).
      The integration suite runs against five different Nextcloud versions, and
      a single version can emit a deprecation warning its neighbours don't (e.g.
      an OCP API that shifts in one release) — that made every NC 32 job fail
      while 30/31/33/34 passed, purely on one warning. The gate should be real
      failures/errors, not a per-version warning. failOnRisky stays on.
    -->
    <testsuites>
        <testsuite name="Integration">
            <directory>./tests/Integration</directory>
        </testsuite>
    </testsuites>
    <groups>
        <include>
            <group>DB</group>
        </include>
    </groups>
    <!--
      No <source>/<coverage> block: coverage against a full-server run is driven
      from the CLI. Every integration class carries @group DB so it can also be
      run from the server's own phpunit.
    -->
</phpunit>
